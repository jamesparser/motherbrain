# --- Motherbrain API (the VPS running `motherbrain serve`) ---
# Leave MB_API_URL empty to run the dashboard on bundled demo data.
MB_API_URL=https://mb.example.com
MB_API_KEY=REPLACE_ME
MB_ADMIN_KEY=REPLACE_ME          # lets the Stripe webhook flip the brain to Pro

# --- Login ---
DASHBOARD_PASSWORD=REPLACE_ME     # empty = demo login (any email, no password)
SESSION_SECRET=REPLACE_ME_LONG_RANDOM

# --- Stripe (test mode until launch) ---
# Simplest: a Payment Link (public URL, no secret on Vercel). API checkout below takes precedence when set.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME   # recurring $5 / month, quantity = agents
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://motherbrain.vercel.app
